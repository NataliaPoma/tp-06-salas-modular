<div class="contenedor-formulario">
  <section class="panel-formulario">
    <h1><%= seccion %></h1>
    <h2>Detalle de la reserva</h2>

    <div class="formulario-doble">
      <!-- Columna izquierda -->
      <div class="columna">
        <p><strong>Estudiante:</strong> <%= reserva.estudiante %></p>
        <p><strong>Email:</strong> <%= reserva.email %></p>
        <p><strong>Sala:</strong> <%= reserva.sala %></p>
      </div>

      <!-- Columna derecha -->
      <div class="columna">
        <p><strong>Fecha:</strong> <%= reserva.fecha %></p>
        <p><strong>Turno:</strong> <%= reserva.turno %></p>
        <p><strong>Personas:</strong> <%= reserva.personas %></p>
      </div>
    </div>

    <div class="boton-reserva">
      <a href="/reservas" class="boton-volver">Volver al listado</a>
    </div>
  </section>
</div>
